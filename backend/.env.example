# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL connection string)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voyageiq?schema=public"

# Authentication / Security Configuration
JWT_SECRET="your_super_secret_jwt_key_change_in_production"

# Frontend Integration
FRONTEND_URL="http://localhost:5173"

# Google OAuth Configuration
GOOGLE_CLIENT_ID="your_google_client_id_placeholder"
GOOGLE_CLIENT_SECRET="your_google_client_secret_placeholder"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/v1/auth/google/callback"

# Gemini API Key
GEMINI_API_KEY="your_gemini_api_key_here"


